# Virtual environments
.venv/
env/
venv/
ENV/

# Downloads and external binaries
downloads/
toolchain/

# Cloned third-party reference repositories
FM-1-RE/
smk-37-pro-docs/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.pytest_cache/

# Intermediate disassembly, dumps, and build objects
firmware_work/disasm/
firmware_work/v16_analysis/
firmware_work/test_*/
